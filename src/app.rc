#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"  // generated by build.bat from VERSION

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "agus4402"
            VALUE "FileDescription", "AppToMic"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "OriginalFilename", "AppToMic.exe"
            VALUE "ProductName", "AppToMic"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 232, 230
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "AppToMic"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    // Texts are replaced at runtime from strings.h (English here as fallback).
    LTEXT           "Apps sent to the virtual microphone:", IDC_APPS_LBL, 7, 8, 160, 9
    PUSHBUTTON      "Refresh", IDC_REFRESH, 175, 5, 50, 14
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 22, 218, 92

    LTEXT           "Microphone:", IDC_MIC_LBL, 7, 123, 46, 9
    COMBOBOX        IDC_MIC, 55, 121, 170, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Apps vol.", IDC_VOLAPP_LBL, 7, 141, 42, 9
    CONTROL         "", IDC_VOLAPP, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP, 46, 138, 150, 15
    LTEXT           "100%", IDC_VOLAPP_TXT, 199, 141, 26, 9

    LTEXT           "Mic vol.", IDC_VOLMIC_LBL, 7, 158, 42, 9
    CONTROL         "", IDC_VOLMIC, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP, 46, 155, 150, 15
    LTEXT           "100%", IDC_VOLMIC_TXT, 199, 158, 26, 9

    AUTOCHECKBOX    "Send audio on open", IDC_AUTOSTART, 7, 179, 110, 10
    AUTOCHECKBOX    "Start with Windows", IDC_WINSTART, 7, 191, 110, 10
    DEFPUSHBUTTON   "Start", IDC_TOGGLE, 165, 181, 60, 16

    LTEXT           "", IDC_STATUS, 7, 209, 218, 18
END
